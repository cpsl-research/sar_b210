# Copy to .env (or run docker/app/setup_env.sh, which writes it for you). Read by compose.yaml.
HOST_UID=1000
HOST_GID=1000
# Group id that owns the B210's USB node: stat -c %g /dev/bus/usb/<bus>/<dev>   (plugdev = 46 on Ubuntu)
USB_GID=46
# Host side of the USB mapping: the whole tree, not one node (the B210 re-enumerates after the FPGA load).
USB_DEV=/dev/bus/usb
# Run folders (iq.bin, bursts.csv, ...) land here; /runs inside the container. Created by setup_env.sh.
RUN_ROOT=/home/you/sar_b210/runs
# GUI bind. A non-loopback address (LAN, tailnet) is unauthenticated.
GUI_HOST=127.0.0.1
GUI_PORT=8010
